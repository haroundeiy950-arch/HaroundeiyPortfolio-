{
  "expo": {
    "name": "HaroundeiyPortfolio",
    "slug": "haroundeiy-portfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#061f3b"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.haroundeiy.portfolio",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-image-picker"
    ]
  }
}